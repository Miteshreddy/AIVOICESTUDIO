# ── Client (Vite — only VITE_ prefixed vars are exposed to the browser) ──────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787

# ── Server (Express — never exposed to the browser) ──────────────────────────
PORT=8787
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ char random secret used to encrypt per-user API keys at rest — generate with `openssl rand -hex 32`
ENCRYPTION_KEY=

# TTS engine: "local" (default, self-hosted Chatterbox — no key needed) or "elevenlabs" (cloud, needs ELEVENLABS_API_KEY)
TTS_PROVIDER=local
LOCAL_TTS_URL=http://localhost:8095

# Only needed if TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Optional — powers AI Rewrite/Summarize/Expand/Translate/Grammar/Emotion tools and voice/pacing recommendations
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional — powers real transcription in the AI features endpoints
DEEPGRAM_API_KEY=

JWT_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

CORS_ORIGIN=http://localhost:5173
